/**
 * Forward declaration of isBadVersion API.
 * @param  version   your version number
 * @return            true if the version is bad
 *                   false if the version is good
 * int isBadVersion(int version);
 */

public class Solution extends VersionControl {
    public int firstBadVersion(int n) {
        int left = 1;
        int right = n;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (isBadVersion(mid)) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return left;
    }
}
